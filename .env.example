PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Private Backblaze B2 bucket for generated PDF order receipts and preview images.
B2_BUCKET_NAME=r3c3ipts
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_REGION=your-region
B2_KEY_ID=your-bucket-scoped-key-id
B2_APPLICATION_KEY=your-bucket-scoped-application-key
# Optional; set only when deployed behind a known number of trusted proxies.
TRUST_PROXY_HOPS=
