PORT=3000
# Set to "production" on Render; enables Secure cookies, HSTS, and HTTPS upgrades.
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
# Server-only key: a Supabase secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key
# Private Backblaze B2 bucket for generated PDF order receipts and preview images.
B2_BUCKET_NAME=your-private-bucket-name
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_REGION=your-region
B2_KEY_ID=your-bucket-scoped-key-id
B2_APPLICATION_KEY=your-bucket-scoped-application-key
# Optional; set only when deployed behind a known number of trusted proxies.
TRUST_PROXY_HOPS=
