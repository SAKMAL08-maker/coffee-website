PORT=3000
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Private Backblaze B2 bucket for generated PDF order receipts and preview images.
B2_BUCKET_NAME=your-private-receipts-bucket
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_REGION=your-region
B2_KEY_ID=replace-with-bucket-scoped-key-id
B2_APPLICATION_KEY=replace-with-bucket-scoped-application-key
# Optional; set only when deployed behind a known number of trusted proxies.
TRUST_PROXY_HOPS=
